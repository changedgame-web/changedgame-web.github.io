":["僕はずっと景色に見とれていた。屋根に住み着いた"]},{"code":401,"indent":0,"parameters":["猫が、自分を狙っていることも気づかずに..."]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["山猫のようだけど、明らかに普通の山猫では"]},{"code":401,"indent":0,"parameters":["なかった。ゴムのような質感を持っている。"]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["とにかく、その「山猫」は自分のいる階に勢いよく"]},{"code":401,"indent":0,"parameters":["着地し、僕はその衝撃で床に倒れこんだ。"]},{"code":231,"indent":0,"parameters":[1,"16",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["それがどんな種類かなんて考える余裕はない。"]},{"code":401,"indent":0,"parameters":["今分かるのは、かなり危険な状況だという事だけだ。"]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["猫は、人間のような足取りで僕に近づき、"]},{"code":401,"indent":0,"parameters":["わざとらしく舌なめずりをすると、威嚇する"]},{"code":401,"indent":0,"parameters":["時のように、前足をゆっくりと下ろした。"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["恐怖で、猫と見つめあったまま固まってしまった。"]},{"code":401,"indent":0,"parameters":["まるで二人の時間が凍り付いたようだった。"]},{"code":250,"indent":0,"parameters":[{"name":"Poison","pan":0,"pitch":100,"volume":80}]},{"code":231,"indent":0,"parameters":[1,"17",0,0,0,0,100,100,255,0]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["そして我に返り、逃げ出そうとした瞬間、"]},{"code":401,"indent":0,"parameters":["猫は僕に飛び掛かった。反射的に目をつむったが、"]},{"code":401,"indent":0,"parameters":["いつまでたっても痛みは来ない、代わりに"]},{"code":401,"indent":0,"parameters":["糊みたいな感触が僕を包んだのを感じた。"]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["全身には穏やかな熱と、不快な粘つき。"]},{"code":401,"indent":0,"parameters":["どことなく体が締め付けられているようにも感じた。"]},{"code":401,"indent":0,"parameters":["どうやら体についた粘液が縮んでいっているようだ。"]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["それは自分がそのネコと一体化しだしているのを"]},{"code":401,"indent":0,"parameters":["意味していた...だんだんと思考がぼやけてくる。"]},{"code":250,"indent":0,"parameters":[{"name":"Poison","pan":0,"pitch":100,"volume":80}]},{"code":231,"indent":0,"parameters":[1,"18",0,0,0,0,100,100,255,0]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["そして僕はネコになった。すでに猫としての"]},{"code":401,"indent":0,"parameters":["自我が芽生え始め、ご機嫌に舌なめずりなんか"]},{"code":401,"indent":0,"parameters":["している。"]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["目に映るのは自分の、新しい体。感じるのは、喜び。"]},{"code":401,"indent":0,"parameters":["このままでは、自分がなんであったか...いや、"]},{"code":401,"indent":0,"parameters":["人間であったかどうかも忘れてしまうだろう。"]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["彼の物語は、あっけなくも終わってしまった..."]},{"code":230,"indent":0,"parameters":[60]},{"code":354,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}]}],"x":25,"y":15}]
